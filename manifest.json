{
  "manifest_version": 3,
  "name": "Moodrot",
  "version": "1.6.0",
  "description": "Custom visual reaction overlays for social media communities.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
